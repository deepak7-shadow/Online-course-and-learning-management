# Backend Environment Variables — copy to .env and fill in values
# DO NOT commit .env — only commit this .env.example file

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Supabase PostgreSQL Connection
DATABASE_URL=jdbc:postgresql://db.uwlyqosmckfwnmezajrf.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-supabase-db-password

# Supabase Auth — from Dashboard → Settings → API
SUPABASE_URL=https://uwlyqosmckfwnmezajrf.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_ANON_KEY=your-supabase-anon-key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
